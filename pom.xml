<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.4</version>
        <relativePath/>
    </parent>

    <groupId>org.upc</groupId>
    <artifactId>coboxmicroservices</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>coboxmicroservices</name>
    <description>coboxmicroservices</description>

    <packaging>pom</packaging>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <springdoc.version>2.8.9</springdoc.version>
        <spring-cloud-aws.version>3.3.1</spring-cloud-aws.version>
    </properties>

    <!-- Spring Cloud AWS 3.3.x = Spring Boot 3.4 / Spring Cloud 2024.0 compatible.
         Business services import their configuration from SSM Parameter Store
         via spring-cloud-aws-starter-parameter-store (version managed here). -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.awspring.cloud</groupId>
                <artifactId>spring-cloud-aws-dependencies</artifactId>
                <version>${spring-cloud-aws.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>config-service</module>
        <module>eureka-service</module>
        <module>gateway-service</module>
        <module>iam-service</module>
        <module>fleet-service</module>
        <module>delivery-service</module>
        <module>edge-service</module>
        <module>mobile-bff-service</module>
        <module>desktop-bff-service</module>
        <module>ai-validation-service</module>
        <module>incident-service</module>
        <module>maintenance-service</module>
        <module>support-service</module>
        <module>report-service</module>
    </modules>
</project>
